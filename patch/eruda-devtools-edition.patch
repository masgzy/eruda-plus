+          { name: 'DNS Lookup', from: dnsStart, to: dnsEnd, cls: 'dns' },
+          {
+            name: 'Initial Connection',
+            from: connectStart,
+            to: connectEnd,
+            cls: 'connect',
+          },
+          {
+            name: 'SSL/TLS',
+            from: sslStart,
+            to: connectEnd,
+            cls: 'ssl',
+          },
+          { name: 'Request Sent', from: requestStart, to: requestStart, cls: 'sent' },
+          {
