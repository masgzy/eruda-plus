+  each(stack.split('\n'), (line) => {
+    const m = line.match(/((?:https?:\/\/|file:\/\/)[^\s)(]+?):(\d+):(\d+)/)
+    if (m) frames.push({ file: m[1], line: +m[2], col: +m[3] })
+  })
+  if (frames.length === 0) return null
+  const own = frames[0].file
